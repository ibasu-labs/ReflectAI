rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document isolated to owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User interactions and reflections strictly isolated to owner
      match /interactions/{interactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Personal Memories - Strictly owned by authenticated user via path isolation
      match /memories/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}

